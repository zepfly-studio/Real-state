# ───────────────────────────────────────────────────────────────
#  Real Estate OS — environment
#  The app runs FULLY on demo data with NONE of the optional keys.
#  Add paid keys here OR (preferred) in Settings → Integrations per tenant.
# ───────────────────────────────────────────────────────────────

# Database (Docker compose maps Postgres 16 to host port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/realestate_os?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me-in-production"

# ── Optional integrations (leave blank — features fall back to demo/mock) ──
ANTHROPIC_API_KEY=""        # Personal AI Assistant, SEO/Creatives copy
NEWS_API_KEY=""             # Property Live News (newsapi.org)
WHATSAPP_API_KEY=""         # WhatsApp CRM (360dialog / Interakt)
APOLLO_API_KEY=""           # Lead Genius enrichment
HUNTER_API_KEY=""           # Lead Genius email finder
CLEARBIT_API_KEY=""         # Lead Genius company enrichment
RAZORPAY_KEY_ID=""          # Finance & Booking payments
RAZORPAY_KEY_SECRET=""
EXOTEL_API_KEY=""           # IVR / Sales calling
MYOPERATOR_API_KEY=""       # IVR / Sales calling
SMTP_URL=""                 # Email digest / notifications
GMAIL_CLIENT_ID=""          # Smart Email Digest OAuth
GMAIL_CLIENT_SECRET=""
META_ACCESS_TOKEN=""        # Social Media Auto Post (IG/FB)
GMAPS_API_KEY=""            # GMB Extractor / Maps
GMB_API_KEY=""              # Google Business Profile
SMS_API_KEY=""              # SMS notifications
MARKET_DATA_API_KEY=""      # Live area-level ₹/sqft market index (PropEquity/Liases Foras). Without it, Price Trends derive from your own inventory.
