{
  "name": "real-estate-os",
  "version": "1.0.0",
  "private": true,
  "description": "Real Estate OS — white-label SaaS for the Indian real estate market (by Creative Sharks)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start",
    "start:prod": "node scripts/deploy-start.mjs",
    "lint": "next lint",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "browser-image-compression": "^2.0.2",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.456.0",
    "next": "14.2.18",
    "next-auth": "^4.24.10",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
